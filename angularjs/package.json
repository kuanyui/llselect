{
  "name": "@llselect/angularjs",
  "version": "0.0.6",
  "description": "AngularJS 1.x directives for llselect: <llselect-single> / <llselect-multiple> driven by an ng-options expression, plus a bridge that accepts ui-select's markup.",
  "main": "./llselect-angularjs.js",
  "files": [
    "llselect-angularjs.js",
    "llselect-angularjs.min.js",
    "llselect-ui-select.js",
    "llselect-ui-select.min.js",
    "README.md",
    "API.md",
    "DESIGN.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "terser llselect-angularjs.js -c -m --comments '/^!/' -o llselect-angularjs.min.js && terser llselect-ui-select.js -c -m --comments '/^!/' -o llselect-ui-select.min.js",
    "test": "npm run check:types && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "prepack": "npm run build",
    "check:types": "tsc -p tsconfig.check.json"
  },
  "peerDependencies": {
    "@llselect/core": "^0.0.6",
    "angular": "^1.5.0"
  },
  "devDependencies": {
    "@llselect/core": "file:..",
    "angular": "1.8.3",
    "angular-ui-bootstrap": "^2.5.6",
    "jsdom": "^25.0.0",
    "terser": "^5.37.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/kuanyui/llselect.git",
    "directory": "angularjs"
  },
  "bugs": {
    "url": "https://gitlab.com/kuanyui/llselect/issues"
  },
  "homepage": "https://gitlab.com/kuanyui/llselect/-/tree/master/angularjs#readme",
  "keywords": [
    "angularjs",
    "angular1",
    "llselect",
    "select",
    "ui-select",
    "ng-options",
    "combobox"
  ],
  "author": "kuanyui (ono ono)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
